# Required: root URL of the self-hosted ytptube HTTP API. Preserve any proxy prefix.
YTPTUBE_BASE_URL=http://127.0.0.1:8080

# Optional authentication. Set both variables together, or leave both unset.
# YTPTUBE_USERNAME=your-username
# YTPTUBE_PASSWORD=your-password

# "basic" (default) sends Authorization: Basic <padded standard Base64(username:password)>.
# "apikey" sends that same encoded value as the ?apikey= fallback; URLSearchParams
# percent-encodes query metacharacters.
YTPTUBE_AUTH_MODE=basic

# Optional request timeout in milliseconds (100 through 300000; default 30000).
YTPTUBE_TIMEOUT_MS=30000

# Exact "true" permits state-changing tools. Keep false for read-only operation.
YTPTUBE_ALLOW_MUTATIONS=false
