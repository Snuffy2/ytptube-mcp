{
  "name": "ytptube-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for a self-hosted YTPTube instance",
  "private": true,
  "type": "module",
  "bin": {
    "ytptube-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
